# DataRova snapshot once a day at 10:00 India time.
# The timezone is part of the schedule, so the server's own zone is irrelevant
# (needs systemd 235+).
[Unit]
Description=DataRova: daily project/ASIN snapshot at 10:00 IST

[Timer]
OnCalendar=*-*-* 10:00:00 Asia/Kolkata
# If the server was down at 10:00, run as soon as it is back.
Persistent=true
RandomizedDelaySec=120
Unit=datarova.service

[Install]
WantedBy=timers.target
