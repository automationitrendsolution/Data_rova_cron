# ---------------------------------------------------------------------------
# DataRova configuration
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored and must never be committed. Exported environment
# variables win over .env, so the same checkout works under systemd too.
# ---------------------------------------------------------------------------

# --- DataRova ----------------------------------------------------------------
DATAROVA_EMAIL=tools.itrend@gmail.com
DATAROVA_PASSWORD=
# DATAROVA_APP_URL=https://app.datarova.com

# --- MySQL -------------------------------------------------------------------
# Leave all DB_* empty to run --dry-run without a database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=powerbidb
DB_USER=powerbi_user
DB_PASSWORD=change-me

DB_TABLE=datarova_all_data
DB_KEYWORDS_TABLE=datarova_keywords
DB_RANKS_TABLE=datarova_ranks
DB_BSR_TABLE=datarova_bsr
# Create the table only if it does not exist at all. Never alters one.
# Review the statement first with: uv run python run.py --show-sql
CREATE_TABLE=false

# TLS. Point DB_SSL_CA at a CA bundle when the server requires one.
# DB_SSL_CA=certs/isrgrootx1.pem
DB_SSL_VERIFY_CERT=false
DB_SSL_DISABLED=false
DB_CONNECT_TIMEOUT_SECONDS=30

# --- Snapshot ----------------------------------------------------------------
# Also read every project's Keywords tab (~23,000 keywords, adds ~10 minutes).
SCRAPE_KEYWORDS=true
# Also read every project's Ranks tab: DataRova's Daily Ranks export (organic +
# sponsored rank + Amazon's Choice, every ASIN x keyword per day) and BSR.
SCRAPE_RANKS=true
# Days of ranks for a project with no rank history yet (first run), then on later runs.
RANKS_INITIAL_DAYS=90
RANKS_DAYS=7
# Zone the snapshot day (scrape_date) is taken in.
DATA_TIMEZONE=Asia/Kolkata
# Pause between two project pages (one page per project, ~70 per run).
PAGE_DELAY_SECONDS=1
# Keep each run's scraped page values in data/raw (deleted after FILE_RETENTION_DAYS).
KEEP_RAW_JSON=false

# --- Paths (relative paths resolve against the project root) -----------------
RAW_DIR=data/raw
SCREENSHOT_DIR=data/screenshots
LOG_DIR=logs
# Chromium profile holding the signed-in DataRova session. Treat as a secret.
SESSION_DIR=data/session
LOCK_FILE=data/datarova.lock
LOCK_WAIT_SECONDS=1800

# --- Browser -----------------------------------------------------------------
HEADLESS=true
BROWSER_TIMEOUT_MS=300000
# How long a table may show DataRova's loading placeholders (doubled on the second pass).
TABLE_TIMEOUT_MS=300000
# How long DataRova may take to build one batch of rank exports.
EXPORT_WAIT_SECONDS=3600
# No progress for this many minutes = frozen browser: it is restarted.
WATCHDOG_MINUTES=30
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
SLOW_MO_MS=0
# Extra Chromium flags, comma-separated. --disable-dev-shm-usage is always on.
BROWSER_ARGS=
# Only when Chromium runs as root in a container.
BROWSER_NO_SANDBOX=false

# --- Retry -------------------------------------------------------------------
# Transient failures only. A rejected sign-in is never retried.
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=10
RETRY_BACKOFF_MAX_SECONDS=120

# --- Logging and housekeeping ------------------------------------------------
LOG_LEVEL=INFO
# logs/datarova.log rotates at UTC midnight; older files are deleted after this.
LOG_RETENTION_DAYS=14
# Screenshots and raw JSON are deleted after this.
FILE_RETENTION_DAYS=30
